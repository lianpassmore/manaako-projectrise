---
import Layout from '../layouts/Layout.astro';
import CrisisModal from '../components/CrisisModal.jsx';
import ReflectionGate from '../components/ReflectionGate.jsx';
---

<Layout title="Final Reflections | Mana Ako x Project Rise">

  <section class="min-h-screen py-10 md:py-12 px-4 md:px-6 bg-rauhuia">
    <div class="max-w-4xl mx-auto text-center mb-8 md:mb-10">
      <h1 class="text-3xl md:text-5xl text-whenua mb-4 md:mb-6 font-bold">Final Reflections — When Culture Meets AI Wānanga</h1>
      <p class="text-lg md:text-xl text-whenua/80 max-w-2xl mx-auto leading-relaxed">
        Ngā mihi nui for being part of tonight's wānanga. Your voice shaped the conversation, and now we'd love to hear what's sitting with you after our time together.
      </p>
      <p class="text-base md:text-lg text-whenua/60 max-w-2xl mx-auto mt-3 md:mt-4">
        This should take about 5 minutes. Your responses will help Lian and Lee understand what landed, what shifted, and what matters most as they continue this mahi.
      </p>
      <p class="text-base md:text-lg text-whenua/60 max-w-2xl mx-auto mt-3 md:mt-4">
        <strong>Prefer to talk it through?</strong> You can have a voice conversation with the AI instead.
      </p>
    </div>

    <ReflectionGate client:only="react" />
  </section>

  <CrisisModal client:load />
</Layout>
