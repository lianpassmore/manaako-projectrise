  }

  /* =============================================
     INTERNATIONAL STANDARDS SECTION
  ============================================= */
  .standards-callout {
    background: var(--rich-black);
    color: var(--off-white);
    padding: 1.5rem 1.75rem;
    margin: 1.5rem 0 2rem;
    border-left: 4px solid var(--yellow);
  }

  .standards-callout p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--off-white);
  }

  .standards-callout strong {
    color: var(--yellow);
  }

  .standards-subhead {
    font-size: 1.125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--rich-black);
    margin: 2.5rem 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--violet);
  }

  .standards-intro {
    font-size: 0.9rem;
    color: var(--muted-grey);
    margin-bottom: 0.5rem;
  }

  .standards-table td:first-child {
    white-space: nowrap;
    min-width: 10rem;
  }

  .standards-table .pou-ref {
    display: block;
    margin-bottom: 0.15rem;
    letter-spacing: 0.04em;
  }

  .standards-table-wide {
    font-size: 0.8rem;
    table-layout: fixed;
  }

  .standards-table-wide th,
  .standards-table-wide td {
    padding: 0.75rem 0.85rem;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .standards-table-wide td:first-child {
    min-width: 9rem;
    width: 14%;
  }

  .standards-beyond {
    background: var(--warm-grey);
    border-left: 4px solid var(--violet);
    padding: 1.5rem 1.75rem;
    margin-top: 2rem;
  }

  .sb-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--violet);
    margin-bottom: 0.75rem;
  }

  .standards-beyond ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .standards-beyond li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--rich-black);
    margin-bottom: 0.85rem;
  }

  .standards-beyond li:last-child {
    margin-bottom: 0;
  }

  .standards-beyond li strong {
    color: var(--rich-black);
  }

  /* =============================================
     HUMAN PROXY — named finding
  ============================================= */
  .named-finding {
    background: var(--rich-black);
    padding: 1.75rem 2rem;
    margin: 1.5rem 0;
  }

  .named-finding .finding-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--yellow);
    margin-bottom: 0.5rem;
  }

  .named-finding h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--pure-white);
    margin-bottom: 0.75rem;
  }

  .named-finding p {
    color: rgba(255,255,255,0.75);
    font-size: 0.875rem;
    margin: 0;
  }

  /* =============================================
     REFERENCE QUICK TABLE
  ============================================= */
  .ref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.825rem;
    margin-top: 1.5rem;
  }

  .ref-table th {
    background: var(--rich-black);
    color: var(--yellow);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.65rem 0.875rem;
    text-align: left;
  }

  .ref-table td {
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--border-light);
    color: var(--muted-grey);
    vertical-align: top;
    line-height: 1.5;
  }

  .ref-table tr:nth-child(even) td { background: var(--off-white); }

  .ref-table td:first-child { font-weight: 700; color: var(--rich-black); }

  .ref-question {
    font-style: italic;
    font-weight: 500;
    color: var(--rich-black);
  }

  .ref-rule {
    font-size: 0.8rem;
  }

  /* =============================================
     WHAKAMUTUNGA / CLOSE
  ============================================= */
  .closing {
    background: var(--rich-black);
    padding: 4rem 0;
    text-align: center;
  }

  .closing h2 {
    color: var(--pure-white);
    margin-bottom: 1rem;
  }

  .closing p {
    color: rgba(255,255,255,0.65);
    max-width: 560px;
    margin: 0 auto 1rem;
  }

  .closing .whakatauaki {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--yellow);
    margin-top: 2.5rem;
    font-style: italic;
  }

  .closing .authors {
    font-size: 0.825rem;
    color: rgba(255,255,255,0.4);
    margin-top: 2rem;
    letter-spacing: 0.02em;
  }

  /* =============================================
     WHAT THIS IS NOT
  ============================================= */
  .not-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .not-item {
    padding: 1.25rem;
    border: 1px solid var(--border-light);
    background: var(--pure-white);
  }

  .not-item .not-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--violet);
    margin-bottom: 0.4rem;
  }

  .not-item p {
    font-size: 0.875rem;
  }

  /* =============================================
     RESPONSIVE
  ============================================= */
  @media (max-width: 900px) {
    .standards-table-wide {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }
    .standards-table-wide th,
    .standards-table-wide td {
      white-space: normal;
      min-width: 12rem;
    }
  }

  @media (max-width: 700px) {
    .how-grid { grid-template-columns: 1fr; }
    .foundation-grid { grid-template-columns: 1fr 1fr; }
    .distinction-grid { grid-template-columns: 1fr; }
    .test-grid { grid-template-columns: 1fr; }
    .not-grid { grid-template-columns: 1fr; }
    .pou-card-header, .pou-card-body { padding: 1.25rem; }
    .checkpoint { padding: 1rem 1.25rem; }
  }
</style>

<!-- is:inline ensures this script doesn't get bundled by Astro, 
     keeping the function available in the global scope if needed -->
<script is:inline>
  window.toggleCompanion = function(btn) {
    const content = btn.nextElementSibling;
    if(!content) return;
    const isOpen = content.classList.contains('visible');
    content.classList.toggle('visible', !isOpen);
    btn.classList.toggle('open', !isOpen);
  };
</script>

